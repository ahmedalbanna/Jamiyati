rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny ALL
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Association Rules
    match /associations/{associationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.directorUid == request.auth.uid 
        && isValidId(associationId);
      allow update: if isSignedIn() && resource.data.directorUid == request.auth.uid;
      
      // Member Subcollection
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && isValidId(memberId); 
        allow update, delete: if isSignedIn() && (
          get(/databases/$(database)/documents/associations/$(associationId)).data.directorUid == request.auth.uid
        );
      }

      // Payment Subcollection
      match /payments/{paymentId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/associations/$(associationId)).data.directorUid == request.auth.uid
          || resource.data.memberId == request.auth.uid // Allow members to see/mark? Usually admin marks payments.
        );
      }

      // Payout Subcollection
      match /payouts/{payoutId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && (
          get(/databases/$(database)/documents/associations/$(associationId)).data.directorUid == request.auth.uid
        );
      }

      // Dispute Subcollection
      match /disputes/{disputeId} {
        allow read: if isSignedIn(); // Basic read access for demo purposes. In production, restrict to reporter and admin.
        allow create: if isSignedIn();
        allow update: if isSignedIn() && (
          get(/databases/$(database)/documents/associations/$(associationId)).data.directorUid == request.auth.uid || 
          resource.data.reporterId == request.auth.uid ||
          resource.data.targetId == request.auth.uid
        );
      }
    }

    match /users/{userId} {
      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow create: if isSignedIn(); // Allow admins or system to create notifications
        allow update: if isOwner(userId); // Mark as read
      }
    }
  }
}
